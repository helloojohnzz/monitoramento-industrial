# Copie este arquivo para .env (o .env NÃO vai para o GitHub) e troque os valores.

# Senhas do MySQL
DB_ROOT_PASSWORD=troque-esta-senha-root
DB_USER=metaltech
DB_PASSWORD=troque-esta-senha

# Chave exigida para gravar dados na API (a ponte do IO-Link usa a mesma).
# Gere uma chave aleatória, por exemplo: openssl rand -hex 32
API_KEY=troque-esta-chave

# Sites que podem chamar a API pelo navegador (separados por vírgula)
CORS_ALLOWED_ORIGINS=https://helloojohnzz.github.io,http://localhost:5173
